# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (PostgreSQL 16 - Synchronous Psycopg 3)
DB_HOST=localhost
DB_PORT=5432
DB_USER=financeflow_user
DB_PASSWORD=financeflow_secret
DB_NAME=financeflow_db
DATABASE_URL=postgresql+psycopg://financeflow_user:financeflow_secret@localhost:5432/financeflow_db

# External Disbursement Service (Downstream)
DISBURSEMENT_SERVICE_BASE_URL=http://localhost:8080
DISBURSEMENT_SERVICE_API_KEY=local_mock_disbursement_key
DISBURSEMENT_TIMEOUT_SECONDS=10.0

# Financial Engine Invariants
DEFAULT_ADVANCE_RATE=0.8000
DEFAULT_FEE_PERCENTAGE=0.0300
DEFAULT_CURRENCY=USD

# Authentication & Multi-Tenancy (Cycle 7 Hardening)
API_KEY_REQUIRED=true
API_KEYS={"financeflow_tenant_alpha":"11111111-1111-1111-1111-111111111111","financeflow_tenant_beta":"22222222-2222-2222-2222-222222222222"}
